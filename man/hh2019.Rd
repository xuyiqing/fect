\name{hh2019}
\alias{hh2019}
\docType{data}
\title{Indirect Democracy and Naturalization in Swiss Municipalities}
\description{Replication data from Hainmueller and Hangartner (2019): Swiss municipalities, 1991 to 2009 (1,209 municipalities). Used in the user manual to study how moving naturalization decisions from direct to indirect democracy affects naturalization rates.}
\format{A data frame with 22,971 rows and 4 variables:
  \describe{
    \item{bfs}{municipality identifier (Swiss Federal Statistical Office number).}
    \item{year}{year (1991 to 2009).}
    \item{nat_rate_ord}{naturalization rate (ordinary naturalizations), in percent.}
    \item{indirect}{1 if naturalization requests are decided under indirect democracy (by an elected body) in that year, 0 if by direct democracy.}
  }
}
\source{Hainmueller, J., and Hangartner, D. (2019). Does Direct Democracy Hurt Immigrant Minorities? Evidence from Naturalization Decisions in Switzerland. \emph{American Journal of Political Science, 63}(3), 530-547.}
\keyword{datasets}
